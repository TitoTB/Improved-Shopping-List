[Unit]
Description=Prepare and publish Carrefour shopping data
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Example paths: replace these with the actual Aguacatec installation.
User=aguacatec
WorkingDirectory=/opt/aguacatec
EnvironmentFile=/etc/aguacatec/shopping-feed.env
ExecStart=/opt/aguacatec/.venv/bin/python manage.py publish_shopping_feed --publish
UMask=0077
NoNewPrivileges=true
